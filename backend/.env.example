# ═══════════════════════════════════════════════════════════
# 爱买买后端 .env 模板
#
# 三段式环境策略（2026-04-19 确立，详见 plan.md C40c3）:
#   本地开发   : SMS_MOCK=true  + ALIPAY 沙箱 + 走图形验证码
#                （admin/123456、cs-001..010/seller123 直通登录）
#   Staging    : SMS_MOCK=false + ALIPAY 真金（证书模式，2026-06-01 由沙箱切换）+ 走图形验证码
#                （模板见 docs/operations/.env.staging）
#   Production : 全部 mock 关闭，真实凭证（见 plan.md C40e checklist）
#
# 复制此文件为 .env 后按本地开发策略调整
# ═══════════════════════════════════════════════════════════

DATABASE_URL="postgresql://user:password@localhost:5432/aimaimai"
# 配送域独立数据库；即使小程序不开放配送企业客户端，后端模块启动仍必须提供。
DELIVERY_DATABASE_URL="postgresql://user:password@localhost:5432/aimaimai_delivery"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN="15m"
PORT=3000

# 管理后台 JWT 密钥（独立于买家 JWT_SECRET，生产环境必须重新生成）
ADMIN_JWT_SECRET="change-me-to-a-random-string-for-admin"

# 卖家后台 JWT 密钥（独立于买家 JWT_SECRET，生产环境必须重新生成）
SELLER_JWT_SECRET="change-me-to-a-random-string-for-seller"

# 配送域三套 JWT 必须彼此独立；production 不得复用买家/管理/卖家 JWT。
DELIVERY_USER_JWT_SECRET="change-me-to-a-random-string-for-delivery-user"
DELIVERY_ADMIN_JWT_SECRET="change-me-to-a-random-string-for-delivery-admin"
DELIVERY_SELLER_JWT_SECRET="change-me-to-a-random-string-for-delivery-seller"

# 配送域 Mock 仅限本地/测试。production 必须显式为 false，缺失也拒绝启动相关认证。
DELIVERY_SMS_MOCK=false
DELIVERY_WECHAT_MOCK=false

# 正常商城配送 / 到店自提：迁移和 staging 联调完成前保持 false
PICKUP_FULFILLMENT_ENABLED=false
# 独立 HMAC 密钥；staging / production 使用不同强随机值
PICKUP_TOKEN_SECRET="change-me-to-an-independent-random-pickup-secret"

# 支付回调 Webhook 签名密钥（生产环境必须配置）
PAYMENT_WEBHOOK_SECRET="change-me-to-a-random-webhook-secret"

# 物流回调 Webhook 签名密钥（生产环境必须配置）
LOGISTICS_WEBHOOK_SECRET="change-me-to-a-random-webhook-secret"

# Webhook IP 白名单（逗号分隔，支持 CIDR。生产环境必须配置支付宝/顺丰 IP 段）
WEBHOOK_IP_WHITELIST=""

# 微信开放平台（微信登录）
WECHAT_MOCK=false
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"
# 微信公众号网页授权（H5 邀请页微信登录，redirect_uri 需配置到公众号网页授权域名）
WECHAT_H5_APP_ID="your-wechat-service-account-app-id"
WECHAT_H5_APP_SECRET="your-wechat-service-account-app-secret"
WECHAT_H5_AUTH_REDIRECT_BASE="https://app.ai-maimai.com/invite"

# 阿里云短信服务（验证码）
SMS_MOCK=false
SMS_ACCESS_KEY_ID="your-aliyun-access-key-id"
SMS_ACCESS_KEY_SECRET="your-aliyun-access-key-secret"
SMS_SIGN_NAME="your-sms-sign-name"
SMS_TEMPLATE_CODE="SMS_xxxxxxxxx"

# 阿里云邮件推送 DirectMail（邮箱验证码）
EMAIL_SMTP_HOST="smtpdm.aliyun.com"
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER="noreply@mail.ai-maimai.com"
EMAIL_SMTP_PASS="your-smtp-password"

# 阿里云 OSS（图片存储）
UPLOAD_LOCAL=true
OSS_REGION="oss-cn-hangzhou"
OSS_ACCESS_KEY_ID="your-aliyun-access-key-id"
OSS_ACCESS_KEY_SECRET="your-aliyun-access-key-secret"
OSS_BUCKET="your-bucket-name"
UPLOAD_BASE_URL="http://localhost:3000/uploads"
# 已验证检测报告受控预览的对外 API 根路径。生产/测试环境必须填对应域名，
# 以兼容仍会读取 inspectionReports[].fileUrl 的旧版 App；绝不可填 OSS 域名。
PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"
# 头像 PATCH 额外可信 URL 前缀（逗号分隔，需精确包含 avatars/ 路径；通常留空）
AVATAR_ALLOWED_URL_PREFIXES=""

# 发票开票安全
# 手工开票 PDF URL 允许的额外前缀，逗号分隔；默认还会允许 UPLOAD_BASE_URL 和 OSS_BUCKET/OSS_REGION 推导域名
INVOICE_PDF_ALLOWED_URL_PREFIXES=""
# Provider 开票预占超过该分钟数后，管理端才允许重置卡住的任务
INVOICE_PROVIDER_RESET_AFTER_MINUTES=10

# 顺丰丰桥（电子面单 + 物流查询 + 物流推送）
# SF_ENV=UAT 走沙箱（通用月结卡 7551234567），SF_ENV=PROD 走生产
SF_ENV="UAT"
SF_API_URL="https://sfapi.sf-express.com/std/service"
SF_API_URL_UAT="https://sfapi-sbox.sf-express.com/std/service"
SF_CLIENT_CODE="your-sf-client-code"
SF_CHECK_WORD="your-sf-check-word"
# 沙箱月结账号（顺丰统一测试卡：7551234567）
SF_MONTHLY_ACCOUNT_UAT="7551234567"
# 生产月结账号（联调通过后顺丰下发的真实卡号）
SF_MONTHLY_ACCOUNT_PROD="your-sf-monthly-account-prod"
SF_CALLBACK_URL="https://api.ai-maimai.com/api/v1/shipments/sf/callback/<same-as-SF_PUSH_SECRET>"
# 路由推送 webhook secret（Bug 87）：32 位随机十六进制
# 同时填入 .env + 顺丰后台推送 URL 末尾 `/<secret>`，双源信任防伪造
# 生成命令：openssl rand -hex 16
SF_PUSH_SECRET=""
# 模板编码必须以 _<SF_CLIENT_CODE> 结尾（例如 fm_150_standard_HHNYKCL5OWXM）
# 启动时校验，配置错误会抛异常
SF_TEMPLATE_CODE="your-template-code_<SF_CLIENT_CODE>"
# E2E 测试 mock 开关（仅在 SF_ENV!=PROD 且 NODE_ENV=test 且本变量为 true 时启用）
SF_ALLOW_E2E_MOCK="false"

# 阿里云百炼平台（语音识别 + Qwen 大模型）
DASHSCOPE_API_KEY="your-dashscope-api-key"

# 支付宝支付
# --- 生产环境（证书模式）---
# ALIPAY_APP_ID="2021006144601730"
# ALIPAY_PRIVATE_KEY_PATH="certs/alipay/app-private-key.txt"
# ALIPAY_APP_CERT_PATH="certs/alipay/appCertPublicKey.crt"
# ALIPAY_PUBLIC_CERT_PATH="certs/alipay/alipayCertPublicKey.crt"
# ALIPAY_ROOT_CERT_PATH="certs/alipay/alipayRootCert.crt"
# ALIPAY_NOTIFY_URL="https://api.ai-maimai.com/payments/alipay/notify"
# --- 沙箱环境（公钥模式）---
# ALIPAY_APP_ID="9021000162667503"
# ALIPAY_PRIVATE_KEY="沙箱应用私钥"
# ALIPAY_PUBLIC_KEY="沙箱支付宝公钥"
# ALIPAY_GATEWAY="https://openapi-sandbox.dl.alipaydev.com/gateway.do"
# ALIPAY_ENDPOINT="https://openapi-sandbox.dl.alipaydev.com"
# ALIPAY_NOTIFY_URL="https://your-ngrok-url/payments/alipay/notify"
# ALIPAY_RETURN_URL="aimaimai://alipay"

# 语义意图升级开关
AI_SEMANTIC_SLOTS_ENABLED=false
AI_PRODUCT_SEMANTIC_FIELDS_ENABLED=false
AI_SEMANTIC_SCORING_ENABLED=false

# ━━━━━━━━━━ 微信支付（v1.1） ━━━━━━━━━━
# 真实凭据见 docs/operations/密码本.md（gitignored），此处仅占位
# 申请流程：详见 docs/superpowers/specs/2026-05-10-wechat-pay-integration-design.md
WECHAT_PAY_APP_ID=""
# 微信小程序登录与 JSAPI 支付复用同一个 AppID；Mock 仅限本地/测试环境
WECHAT_MINIAPP_MOCK=false
WECHAT_MINIAPP_APP_ID=""
WECHAT_MINIAPP_APP_SECRET=""
# 小程序一次性订阅消息：模板 ID 和字段键均以微信后台实际申请结果为准。
# FIELDS 仅允许 reference/status/remark/time 映射到微信模板字段；缺失时 fail-closed。
WECHAT_MINIAPP_SUBSCRIBE_ORDER_SHIPPED_TEMPLATE_ID="AaefuI_Uqp1qvX7fNuGbEe3w6Qe4b4M5SUpboeLXvNQ"
WECHAT_MINIAPP_SUBSCRIBE_ORDER_SHIPPED_FIELDS='{"reference":"character_string6","status":"phrase18","remark":"thing5","time":"date4"}'
WECHAT_MINIAPP_SUBSCRIBE_AFTER_SALE_RESULT_TEMPLATE_ID="sAQM7NcmYHH6x1nxlqr_Fy2EBushICGBCt42XPsG04Q"
WECHAT_MINIAPP_SUBSCRIBE_AFTER_SALE_RESULT_FIELDS='{"reference":"character_string7","status":"thing2","remark":"thing5","time":"time12"}'
WECHAT_MINIAPP_SUBSCRIBE_WITHDRAW_RESULT_TEMPLATE_ID="2zKL7siL8vg7U8t31koS272-CQBxTz9ePaXoi1vXAYU"
WECHAT_MINIAPP_SUBSCRIBE_WITHDRAW_RESULT_FIELDS='{"status":"phrase2","remark":"thing4","time":"time3"}'
# developer / trial / formal；生产必须使用 formal。
WECHAT_MINIAPP_SUBSCRIBE_STATE="formal"
# 无限小程序码：正式发布用 release + check_path=true；开发联调可临时改为 develop/false。
WECHAT_MINIAPP_CODE_ENV_VERSION="release"
WECHAT_MINIAPP_CODE_CHECK_PATH="true"
WECHAT_MINIAPP_CODE_SCENE_TTL_DAYS="365"
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_MERCHANT_CERT_SERIAL=""
# 商户证书（apiclient_cert.pem）支持两种方式（任一）：
#   1) 内联：apiclient_cert.pem 全文（含 BEGIN/END）作为单行字符串（\n 转义）
#   2) 路径：指向 PEM 文件（相对 backend/）— 优先级低于内联
WECHAT_PAY_MERCHANT_CERT=""
WECHAT_PAY_MERCHANT_CERT_PATH=""
# 商户私钥（apiclient_key.pem）支持两种方式：
#   1) 内联：apiclient_key.pem 全文（含 BEGIN/END）作为单行字符串（\n 转义）
#   2) 路径：指向 PEM 文件（相对 backend/）— 优先级低于内联
WECHAT_PAY_MERCHANT_PRIVATE_KEY=""
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=""
WECHAT_PAY_NOTIFY_URL="https://api.ai-maimai.com/api/v1/payments/wechat/notify"

# 微信支付「商家转账」单笔用户确认模式（默认关闭；缺任一配置时 fail-closed）
WECHAT_TRANSFER_ENABLED=false
WECHAT_TRANSFER_NOTIFY_URL="https://api.ai-maimai.com/api/v1/bonus/withdraw/wechat/notify"
# staging 必须显式覆盖为 https://test-api.ai-maimai.com/api/v1/bonus/withdraw/wechat/notify
# 商户平台申请的转账场景 ID 与报备内容，必须使用获批的真实值。
# 当前小程序申请的是“佣金报酬”(1005)：获批后必须恰好报备“岗位类型”和
# “报酬说明”两项真实内容；未获批或信息不完整时保持 WECHAT_TRANSFER_ENABLED=false。
WECHAT_TRANSFER_SCENE_ID="1005"
WECHAT_TRANSFER_REMARK="AI爱买买佣金报酬提现"
WECHAT_TRANSFER_USER_RECV_PERCEPTION="劳务报酬"
# JSON 数组格式；1005 仅允许“岗位类型”和“报酬说明”，内容须与真实业务逐笔一致。
WECHAT_TRANSFER_SCENE_REPORT_INFOS_JSON='[{"info_type":"岗位类型","info_content":"平台推广人员"},{"info_type":"报酬说明","info_content":"AI爱买买平台推广佣金"}]'
# 微信支付公钥验签（不是平台证书序列号）；ID 格式 PUB_KEY_ID_xxx
WECHAT_PAY_PUBLIC_KEY_ID=""
WECHAT_PAY_PUBLIC_KEY=""
WECHAT_PAY_PUBLIC_KEY_PATH=""
